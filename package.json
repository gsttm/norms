{
  "name": "norms",
  "version": "0.0.5",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "norms": "./dist/norms.js"
  },
  "scripts": {
    "build": "bun run build:cli && bun run build:vscode",
    "build:cli": "bun build packages/cli/src/index.tsx --target=bun --outfile=dist/norms.js",
    "build:vscode": "bun build packages/vscode/src/extension.ts --target=node --format=cjs --outfile=packages/vscode/dist/extension.js --external=vscode",
    "build:vscode-tests": "bun build packages/vscode/test/extension.integration.ts --target=node --format=cjs --outfile=packages/vscode/dist/test/extension.integration.js --external=vscode",
    "check": "bun run check:types && bun run check:norms",
    "check:norms": "bun packages/cli/src/index.tsx check --json",
    "check:types": "tsc --noEmit",
    "dev": "bun packages/cli/src/index.tsx",
    "lint": "bun run check",
    "package": "bun build packages/cli/src/index.tsx --compile --outfile=dist/norms",
    "package:release": "bun scripts/build-release.ts",
    "test:e2e": "bun test packages/cli/test/workflow.e2e.test.ts",
    "test:installer": "sh scripts/test-installer.sh",
    "test:vscode": "bun run build:vscode && bun run build:vscode-tests && vscode-test",
    "test": "bun test"
  },
  "dependencies": {
    "ink": "^6.3.1",
    "minimatch": "^10.0.3",
    "react": "^19.1.1",
    "react-devtools-core": "^7.0.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/vscode": "^1.103.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.9.2"
  }
}
